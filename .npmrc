# Configuración de seguridad para pnpm
# Bloquea scripts de instalación por defecto
ignore-scripts=false

# Evita instalar versiones publicadas el mismo día
# 1440 minutos = 24 horas
minimumReleaseAge=1440

# Usar pnpm como gestor de paquetes
package-manager=pnpm@11

# Verificación de integridad
verify-store-integrity=true

# Usar lockfile v5 (más seguro)
lockfile-version=5.4
